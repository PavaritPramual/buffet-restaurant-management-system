                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "place",
        "responses": {
          "201": {
            "description": "Customer order created with RECEIVED status",
            "headers": {
              "Location": {
