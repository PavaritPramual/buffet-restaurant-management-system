                    "$ref": "#/components/schemas/StockItemResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Staff login required",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
