    "/api/v1/orders/{id}/status": {
      "patch": {
        "operationId": "updateStatus",
        "responses": {
          "409": {
            "description": "Recipe stock is insufficient or unavailable; no partial consumption",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Transition is not the next legal status",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "Order transitioned to its next legal status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "401": {
            "description": "Staff login required",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Role does not permit this transition",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "schemas": {
    "ErrorResponse": {
      "type": "object",
      "description": "Standard error body returned for API failures",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "UTC time when the error was created",
          "example": "2026-10-07T08:09:10Z"
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "HTTP status code"
        },
        "error": {
          "type": "string",
          "description": "HTTP reason phrase"
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message"
        },
        "path": {
          "type": "string",
          "description": "Request path"
        }
      }
    },
    "MenuItemResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64"
        },
        "categoryId": {
          "type": "integer",
          "format": "int64"
        },
        "categoryName": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "packageIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "uniqueItems": true
        },
        "imageUrl": {
          "type": "string"
        }
      }
    },
    "OrderResponse": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "integer",
          "format": "int64"
        },
        "sessionId": {
          "type": "integer",
          "format": "int64"
        },
        "tableNumber": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Item"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "RECEIVED",
            "PREPARING",
            "READY",
            "SERVED"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
