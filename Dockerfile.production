FROM node:22-bookworm-slim AS frontend-build
WORKDIR /frontend
COPY code/frontend/package.json code/frontend/package-lock.json ./
RUN npm ci
COPY code/frontend/ ./
ENV VITE_API_BASE_URL=/api/v1
RUN npm run build

FROM eclipse-temurin:17-jdk AS backend-build
WORKDIR /backend
COPY code/backend/.mvn/ .mvn/
COPY code/backend/mvnw code/backend/pom.xml ./
RUN chmod +x mvnw
COPY code/backend/src/ src/
COPY --from=frontend-build /frontend/dist/ src/main/resources/static/
RUN ./mvnw -B -DskipTests package

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=backend-build /backend/target/app.jar app.jar
EXPOSE 10000
ENTRYPOINT ["java", "-jar", "app.jar"]
