@startuml
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFDF9
skinparam defaultFontName Tahoma
title Behavioral Template Method - actual Stock classes
abstract class StockTransactionTemplate {
 +{final} process(item, quantity, reason, actor) : StockTransaction
 #{abstract} calculateDelta(quantity) : BigDecimal
 #{abstract} transactionType() : StockTransactionType
}
interface StockTransactionProcessor {
 +process(item, quantity, reason, actor) : StockTransaction
}
class StockInProcessor
class StockAdjustmentProcessor
class StockService {
 +createItem(request) : StockItemResponse
 +updateItem(id, request) : StockItemResponse
 +setActive(id, active) : StockItemResponse
 +overview()
 +stockIn(id, request, actor)
 +adjust(id, request, actor)
 +history(itemId)
}
class StockItem {
 sku : String
 name : String
 unit : String
 quantity : BigDecimal
 lowStockThreshold : BigDecimal
 openingTargetStock : BigDecimal (V15)
 active : boolean (V15)
 archivedAt : Instant (V16)
 +archive() : void
 +restore() : void
 +updateDetails(sku, name, unit, threshold) : void
 +updateOpeningTarget(target) : void
 +changeActive(active) : void
 +getShortfall() : BigDecimal
 +applyDelta(delta) : void
}
class StockTransaction {
 orderId : Long (nullable except CONSUMPTION)
 transactionType : StockTransactionType
 quantityDelta : BigDecimal
 balanceAfter : BigDecimal
 reason : String
 createdAt : Instant
}
interface StockItemRepository
interface StockTransactionRepository
interface UserAccountRepository
class StockConsumptionProcessor
interface StockConsumptionTransactionProcessor
interface OrderStockConsumptionService
class OrderStockConsumptionServiceImpl
StockTransactionTemplate <|-- StockConsumptionProcessor
StockConsumptionTransactionProcessor <|.. StockConsumptionProcessor
OrderStockConsumptionService <|.. OrderStockConsumptionServiceImpl
OrderStockConsumptionServiceImpl --> StockConsumptionTransactionProcessor
OrderStockConsumptionServiceImpl --> StockItemRepository : stock IDs ascending
StockTransactionTemplate <|-- StockInProcessor
StockTransactionTemplate <|-- StockAdjustmentProcessor
StockTransactionProcessor <|.. StockTransactionTemplate
StockService --> StockTransactionProcessor : qualified IN / ADJUSTMENT policies
StockService --> StockItemRepository : lock row before process
StockTransactionTemplate --> StockItemRepository
StockTransactionTemplate --> StockTransactionRepository
StockTransactionTemplate --> UserAccountRepository
StockItem "1" -- "0..*" StockTransaction
note bottom of StockTransactionTemplate
 final workflow: actor -> active guard (409) -> delta -> nonnegative balance
 -> apply/save -> audit actor/reason/balance.
 Transaction belongs to StockService or Fulfillment, not the template.
 Consumption uses processWithOrder final workflow; order_id / negative delta / unique order-stock audit.
 Types: IN / ADJUSTMENT / CONSUMPTION. Adjustment uses signed delta.
 openingTargetStock/active implemented by V15; shortfall = max(target - quantity, 0), derived, not persisted.
 Manager-only item create/update/active; inactive item rejects stock-in/adjust with 409.
 SKU and unit are locked once transactions exist; recipe/snapshot references also lock unit.
end note
@enduml
