@startuml
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor #FFF9EE
skinparam defaultFontName Tahoma
skinparam defaultFontSize 18
skinparam classAttributeIconSize 0
skinparam ArrowColor #A54A2E
skinparam classBackgroundColor #FFF9EE
skinparam classBorderColor #173A45
skinparam actorBorderColor #173A45
skinparam usecaseBackgroundColor #F2E6D4
skinparam usecaseBorderColor #A54A2E
title Public deployment design - planned topology, not deployed evidence
node "Browser / HTTPS" as Browser
cloud "Render Web Service - design target" {
 node "Single origin Spring Boot" as App {
  artifact "React static build" as Web
  component "REST API / Swagger" as API
 }
}
database "Supabase PostgreSQL\nSession Pooler + SSL" as DB
Browser --> Web : HTTPS routes
Browser --> API : HTTPS / Secure cookies
API --> DB : JDBC SSL
note bottom of App
This is deployment design, not a public URL / release certificate.
Production build, Origin, port and restart behavior need runtime verification.
end note
@enduml
