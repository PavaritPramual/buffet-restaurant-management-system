@startuml
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor #FFF9EE
skinparam defaultFontName Tahoma
skinparam defaultFontSize 18
skinparam classAttributeIconSize 0
skinparam ArrowColor #A54A2E
skinparam classBackgroundColor #FFF9EE
skinparam classBorderColor #173A45
skinparam actorBorderColor #173A45
skinparam usecaseBackgroundColor #F2E6D4
skinparam usecaseBorderColor #A54A2E
title Stock management activity - V15 actual (item lifecycle + signed delta)
|Manager / Supervisor|
start
:Login with stock permission;
:Read quantity / threshold / target / active / history;
if (Manager changes item metadata?) then (yes)
 :Create item, edit metadata or set active / inactive;
 |System|
 :Validate request and lock StockItem;
 if (SKU duplicate, or SKU/unit changed after history?) then (yes)
  :Reject with 409;
 else (no)
  :Save metadata / opening target / active;
  :Keep quantity and history unchanged;
 endif
 |Manager / Supervisor|
else (no)
endif
:Choose stock-in or adjustment;
:Enter quantity or signed delta and reason;
|System|
:Validate request;
:Lock StockItem in StockService transaction;
if (Item inactive?) then (yes)
 :Reject with 409 without changing item or history;
 stop
else (no)
endif
:Calculate next balance from current plus delta;
if (Next balance negative?) then (yes)
 :Reject with 400 without changing item or history;
else (no)
 :Save item quantity;
 :Save IN / ADJUSTMENT with actor, reason, balance_after;
 :Commit item and history together;
endif
stop
@enduml
