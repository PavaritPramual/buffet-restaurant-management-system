@startuml
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor #FFF9EE
skinparam defaultFontName Tahoma
skinparam defaultFontSize 18
skinparam classAttributeIconSize 0
skinparam ArrowColor #A54A2E
skinparam classBackgroundColor #FFF9EE
skinparam classBorderColor #173A45
skinparam actorBorderColor #173A45
skinparam usecaseBackgroundColor #F2E6D4
skinparam usecaseBorderColor #A54A2E
title Manager and Supervisor use cases
left to right direction
actor "MANAGER" as Manager
actor "SUPERVISOR" as Supervisor
rectangle "Restaurant administration" {
 usecase "Login / logout" as Login
 usecase "Manage users / profiles" as Users
 usecase "Manage tables / packages / soups" as Catalog
 usecase "Manage menu categories / items" as Menu
 usecase "Manage stock master data" as Master
 usecase "View stock / transaction history" as Read
 usecase "Record stock-in / signed adjustment" as Move
}
Manager --> Login
Supervisor --> Login
Manager --> Users
Manager --> Catalog
Manager --> Menu
Manager --> Master
Manager --> Read
Manager --> Move
Supervisor --> Read
Supervisor --> Move
note bottom of Supervisor
No Kitchen / Serving / Payment privilege.
end note
@enduml
