@startuml
left to right direction

actor Customer
actor Staff
actor "Head Staff / Supervisor" as HeadStaff
actor "Kitchen Staff" as Kitchen
actor "Manager / Admin" as Manager

rectangle "Buffet Restaurant Management System" {

  usecase "View Menu" as UC1
  usecase "Place Order" as UC2
  usecase "View Order Status" as UC3
  usecase "Request Bill" as UC4

  usecase "Login" as UC5
  usecase "Open Dining Session" as UC6
  usecase "Setup Dining Session" as UC7
  usecase "Select Buffet Package" as UC20
  usecase "Serve Order" as UC8
  usecase "Process Payment" as UC9
  usecase "Close Dining Session" as UC10
  usecase "View Stock" as UC11
  usecase "Record Stock In" as UC18
  usecase "Adjust Stock" as UC19

  usecase "View Incoming Orders" as UC12
  usecase "Update Order Status" as UC13

  usecase "Manage Menu" as UC14
  usecase "Manage Buffet Package" as UC15
  usecase "Manage Tables" as UC16
  usecase "Manage Stock Items" as UC17
}

Customer --> UC1
Customer --> UC2
Customer --> UC3
Customer --> UC4

Staff --> UC5
Staff --> UC6
Staff --> UC8
Staff --> UC9
Staff --> UC10

HeadStaff --> UC5
HeadStaff --> UC11
HeadStaff --> UC18
HeadStaff --> UC19

Kitchen --> UC5
Kitchen --> UC12
Kitchen --> UC13

Manager --> UC5
Manager --> UC14
Manager --> UC15
Manager --> UC16
Manager --> UC17

' Required subflows
UC6 ..> UC7 : <<include>>
UC7 ..> UC20 : <<include>>

@enduml
