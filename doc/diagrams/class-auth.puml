@startuml
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor #FFF9EE
skinparam defaultFontName Tahoma
skinparam defaultFontSize 18
skinparam classAttributeIconSize 0
skinparam ArrowColor #A54A2E
skinparam classBackgroundColor #FFF9EE
skinparam classBorderColor #173A45
skinparam actorBorderColor #173A45
skinparam usecaseBackgroundColor #F2E6D4
skinparam usecaseBorderColor #A54A2E
title User and server-session authentication - actual classes
class UserAccount {
passwordHash : String
role : UserRole
active : boolean
}
class UserProfile {
userId : Long
displayName : String
email : String
firstName : String
lastName : String
phoneNumber : String
+updateContact(firstName, lastName, phoneNumber)
}
class AuthService {
+authenticate(username, password) : UserContext
+createUser(request) : UserResponse
+updateProfile(id, request) : UserResponse
}
interface UserAccountRepository <<Repository>>
interface UserProfileRepository <<Repository>>
class AuthController {
+login(request)
+logout()
}
class SessionUserContextProvider {
+requireCurrentRequestRole(role)
}
class HttpSession
UserAccount "1" -- "0..1" UserProfile : shared PK / MapsId
interface AuthenticationService
interface UserAdministrationService
interface UserContextProvider
class UserSessionKeys <<common>>
class AdminUserController
AuthenticationService <|.. AuthService
UserAdministrationService <|.. AuthService
UserContextProvider <|.. SessionUserContextProvider
AuthController --> AuthenticationService
AuthController --> UserContextProvider
AdminUserController --> UserAdministrationService
AdminUserController --> UserContextProvider
AuthController ..> UserSessionKeys
SessionUserContextProvider ..> UserSessionKeys
AuthService --> UserAccountRepository
AuthService --> UserProfileRepository
AuthController --> HttpSession : UserContext
SessionUserContextProvider --> HttpSession
note bottom of AuthService
Authentication and user administration have separate contracts.
Profile is optional in the database (0..1).
createUser creates both; authenticate requires a profile.
Only list/create/updateProfile are implemented; V15 profile names/phone are nullable for legacy rows.
Incomplete session identities return 401; disallowed roles return 403.
end note
@enduml
