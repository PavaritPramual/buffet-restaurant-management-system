@startuml
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFDF9
skinparam defaultFontName Tahoma
title Table / DiningSession / customer grants - actual classes
class RestaurantTable {
 id : Long
 tableNumber : String
 capacity : Integer
 status : TableStatus
 +isAvailable() : boolean
 +occupy() : void
 +makeAvailable() : void
}
class DiningSession {
 id : Long
 adultCount : Integer
 childCount : Integer
 packagePriceAtOpen : BigDecimal
 sessionToken : String
 startTime : LocalDateTime
 endTime : LocalDateTime
 billRequestedAt : OffsetDateTime
 status : DiningSessionStatus
 +requestBill() : void
 +rotateQrToken(token) : void
 +complete(endTime) : void
}
class CustomerSessionGrant {
 tokenHash : String
 createdAt : OffsetDateTime
 expiresAt : OffsetDateTime
}
class BuffetPackage {
 price : BigDecimal
 active : boolean
}
class Soup {
 active : boolean
}
interface DiningSessionService
class DiningSessionServiceImpl {
 +openSession(request) : DiningSessionResponse
 +closeSession(id) : DiningSessionResponse
}
class CustomerSessionAccessService {
 +exchange(qrToken) : ExchangeResult
 +requireContext(credential) : CustomerSessionResponse
 +requireSession(id, credential, forOrder) : SessionContextSnapshot
}
class CustomerBillingService {
 +request(id, credential) : CustomerBillStatusResponse
 +status(id, credential) : CustomerBillStatusResponse
}
interface CustomerSessionVerifier
interface BillCalculator
CustomerSessionVerifier <|.. CustomerSessionAccessService
CustomerBillingService --> CustomerSessionVerifier
CustomerBillingService --> BillCalculator
interface DiningSessionBillingReader
interface PaymentStatusLookup
interface DiningSessionRepository {
 +findByIdForUpdate(id)
 +findBySessionTokenForUpdate(token)
}
RestaurantTable "1" -- "0..*" DiningSession
BuffetPackage "1" -- "0..*" DiningSession
Soup "1" -- "0..*" DiningSession
DiningSession "1" -- "0..*" CustomerSessionGrant
DiningSessionService <|.. DiningSessionServiceImpl
DiningSessionServiceImpl --> DiningSessionRepository
DiningSessionServiceImpl --> PaymentStatusLookup : same-session PAID
CustomerSessionAccessService --> DiningSessionRepository : QR / order locks
CustomerBillingService --> DiningSessionRepository : bill-request lock
DiningSessionBillingReader ..> DiningSession : read snapshot
note bottom of DiningSession
 ACTIVE -> COMPLETED only after PAID + separate close.
 CANCELLED is declared in enum; no cancel endpoint implemented.
 Bill request keeps ACTIVE but blocks new Orders.
 QR token is Staff-only; customers receive no snapshot/QR token.
end note
@enduml
