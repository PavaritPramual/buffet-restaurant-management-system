@startuml
title Billing strategies and public response boundary
interface BillCalculationStrategy {
 +calculate(context) : BigDecimal
}
interface DiscountCalculationStrategy {
 +calculateDiscount(context, subtotal) : BigDecimal
}
class StandardBillCalculation
class ChildRateCalculationStrategy {
 -rate : BigDecimal
}
class PromotionDiscountStrategy
class BillingEngine {
 +calculate(context) : BillCalculation
}
class BillCalculation <<internal>> {
 subtotalNoneDiscount
 discountAmount
 totalBeforeRounding
 roundingAdjustment
 totalAmount
}
class BillingPreviewService
class BillSummary <<public DTO>> {
 sessionId
 subtotalAmount
 discountAmount
 totalAmount
}
BillCalculationStrategy <|.. StandardBillCalculation
BillCalculationStrategy <|.. ChildRateCalculationStrategy
DiscountCalculationStrategy <|.. PromotionDiscountStrategy
StandardBillCalculation o-- ChildRateCalculationStrategy : delegates child amount
BillingEngine o-- BillCalculationStrategy : pricing
BillingEngine o-- DiscountCalculationStrategy : discount
BillingEngine --> BillCalculation
BillingPreviewService --> BillingEngine
BillingPreviewService --> BillSummary : maps display amounts
note bottom of BillingEngine
 Strategies are immutable/stateless and injected.
 Calculate exactly, round payable total once HALF_UP.
 Composition replaces the obsolete addStrategy list design;
 API/architecture owners must review this design delta.
end note
@enduml
