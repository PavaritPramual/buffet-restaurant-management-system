@startuml
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFDF9
skinparam defaultFontName Tahoma

title Domain Model - Buffet Restaurant Management System

skinparam classAttributeIconSize 0
skinparam shadowing false

class UserAccount {
    id
    username
    role
    active
}

class RestaurantTable {
    id
    tableNumber
    capacity
    status
}

class DiningSession {
    id
    adultCount
    childCount
    billRequestedAt
    packagePriceAtOpen
    sessionToken
    startTime
    endTime
    status
}

class CustomerSessionGrant {
    id
    tokenHash
    createdAt
    expiresAt
}

class BuffetPackage {
    id
    name
    price
    active
}

class Soup {
    id
    name
    active
}

class MenuCategory {
    id
    name
}

class MenuItem {
    id
    name
    description
    imageUrl
    available
}

class Order {
    id
    status
    createdAt
}

class OrderItem {
    id
    quantity
    note
}

class Payment {
    id
    amount
    paymentMethod
    paymentStatus
    paidAt
}

class StockItem {
    id
    name
    unit
    sku
    quantity
    lowStockThreshold
}

class StockTransaction {
    id
    type
    quantity
    reason
    createdAt
}

RestaurantTable "1" -- "0..*" DiningSession : hosts >
BuffetPackage "1" -- "0..*" DiningSession : selected in >
Soup "1" -- "0..*" DiningSession : selected in >

BuffetPackage "*" -- "*" MenuItem : includes >
MenuCategory "1" -- "0..*" MenuItem : categorizes >

DiningSession "1" -- "0..*" Order : contains >
DiningSession "1" -- "0..*" CustomerSessionGrant : authorizes >
Order "1" -- "1..*" OrderItem : consists of >
MenuItem "1" -- "0..*" OrderItem : ordered as >

DiningSession "1" -- "0..1" Payment : billed for >

StockItem "1" -- "0..*" StockTransaction : tracked by >
UserAccount "1" -- "0..*" StockTransaction : recorded by >

note bottom of StockItem
 openingTargetStock / active planned for Final; absent in 472fba4.
end note
@enduml
