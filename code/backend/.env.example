# Supabase Session Pooler host (port 5432)
SUPABASE_DB_HOST=aws-0-your-region.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=postgres.your-project-ref
SUPABASE_DB_PASSWORD=change-me

# Optional local overrides
# DB_MAX_POOL_SIZE=5
# FLYWAY_ENABLED=true

# Optional: override the default frontend origin
# CORS_ALLOWED_ORIGINS=http://localhost:5173